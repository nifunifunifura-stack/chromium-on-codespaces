#!/usr/bin/env bash
set -Eeuo pipefail

workspace_root="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || pwd)"
install_dir="$workspace_root/.codespaces-chromium"

if [[ ! -f "$install_dir/.env" || ! -f "$install_dir/docker-compose.yml" ]]; then
  printf 'Run codespaces-chromium/setup.sh from the workspace root first.\n' >&2
  exit 1
fi

compose=(docker compose --env-file "$install_dir/.env" -f "$install_dir/docker-compose.yml" -p codespaces-chromium)
"${compose[@]}" up -d --remove-orphans

for attempt in {1..30}; do
  status="$(curl --silent --insecure --output /dev/null --write-out '%{http_code}' https://127.0.0.1:6901/ || true)"
  if [[ "$status" != "000" ]]; then
    printf 'Google Chrome is ready on forwarded port 6901 (HTTPS %s).\n' "$status"
    printf 'Open the forwarded Chrome tab; access is private.\n'
    exit 0
  fi
  sleep 2
done

printf 'Google Chrome did not respond on port 6901. Check: %s logs chrome\n' "${compose[*]}" >&2
exit 1
