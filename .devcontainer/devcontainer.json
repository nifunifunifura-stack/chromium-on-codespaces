{
  "name": "Codespaces Google Chrome Browser",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "postCreateCommand": "mkdir -p browser-data && sudo install -m 755 .devcontainer/webopen .devcontainer/web /usr/local/bin/",
  "postStartCommand": "docker compose up -d --remove-orphans",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    }
  },
  "forwardPorts": [
    6901
  ],
  "portsAttributes": {
    "6901": {
      "label": "Google Chrome browser",
      "onAutoForward": "openBrowser",
      "protocol": "https",
      "visibility": "private"
    }
  }
}
