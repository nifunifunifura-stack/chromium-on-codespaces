#!/usr/bin/env bash
set -Eeuo pipefail

if [[ ! -f docker-compose.yml || ! -f .env ]]; then
  printf 'Run webopen from the workspace root after creating .env from .env.example.\n' >&2
  exit 1
fi

mkdir -p browser-data
docker compose up -d --remove-orphans

for attempt in {1..30}; do
  status="$(curl --silent --insecure --output /dev/null --write-out '%{http_code}' https://127.0.0.1:6901/ || true)"
  if [[ "$status" != "000" ]]; then
    printf 'Google Chrome is ready on forwarded port 6901 (HTTPS %s).\n' "$status"
    printf 'Open the forwarded Chrome tab; access remains private.\n'
    exit 0
  fi
  sleep 2
done

printf 'Google Chrome did not respond on port 6901. Check `docker compose logs chrome`.\n' >&2
exit 1
